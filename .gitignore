# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
*.db
*.db-shm
*.db-wal
polymarket.db*

# JEV runtime generated files & history
/jev/*
!/jev/.gitkeep
/public/jev/*
!/public/jev/.gitkeep

# Up/Down per-minute tick recorder output (src/lib/updownRecorder.ts)
/ticks/

# Up/Down backfill research outputs (re-created by research/updown/*.py; see research/updown/README.md)
/research/updown/*.parquet
/research/updown/raw/
/research/updown/period.json
/research/updown/validation.json
/research/updown/bt_dataset.json
/research/updown/*.log
/research/updown/.venv/
/research/updown/__pycache__/
