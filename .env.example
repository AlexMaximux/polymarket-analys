# Polymarket Pulse Environment Template
OPENROUTER_API_KEY=your_openrouter_api_key_here
JEV_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
JEV_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Polymarket Trading Bot Settings
TRADER_TELEGRAM_BOT_TOKEN=your_trader_telegram_bot_token_here
TRADER_TELEGRAM_CHAT_ID=your_telegram_chat_id_here
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_TYPE=EOA # EOA, POLY_PROXY, or POLY_GNOSIS_SAFE
POLYMARKET_PROXY_ADDRESS=
POLYMARKET_TOTAL_BUDGET=100 # Maximum total budget in USD allowed to spend
POLYMARKET_PER_TRADE_AMOUNT=10 # Allowed amount in USD per trade
POLYMARKET_SIMULATION_MODE=false # If true, paper-trades on live orderbook without spending real money
POLYMARKET_RPC_URL=https://polygon-rpc.com

